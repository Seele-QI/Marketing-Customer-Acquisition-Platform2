# 中台项目 — 环境变量模板
# 复制本文件为 .env，填入真实 Key 后保存
# 该文件被 docker-compose.yml 自动读取

# ── 必填：AI 服务 Key ──────────────────────────────────
DEEPSEEK_API_KEY=sk-你的DeepSeek密钥
RUNNINGHUB_API_KEY=你的RunningHub密钥

# ── 必填：阿里云语音识别（ASR 自动字幕 / 文案提取兜底）───
ALIYUN_ACCESS_KEY_ID=你的阿里云AccessKeyId
ALIYUN_ACCESS_KEY_SECRET=你的阿里云AccessKeySecret
ALIYUN_ASR_APP_KEY=你的NLS项目AppKey

# ── 可选：智凌文案提取（抖音/快手/视频号优先通道）───
ZHILING_API_KEY=你的智凌API密钥

# ── 必填：邮箱登录（Magic Link）─────────────────────────
RESEND_API_KEY=re_你的Resend密钥
RESEND_FROM=中台 <noreply@你的域名.com>
APP_PUBLIC_BASE=http://localhost:3000

# ── 必填：安全相关 ─────────────────────────────────────
EMAIL_HASH_SALT=随机生成32字节hex（python -c "import secrets; print(secrets.token_hex(32))"）
CREDIT_ADMIN_ACCESS_KEY=后台内部密钥（随机生成，仅服务端代理 FastAPI 用，管理员 UI 不填写）
ADMIN_LOGIN_NAME=18000634365
# 生成方式：node scripts/hash-admin-password.mjs 你的密码
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD_SALT=

# ── 可选：积分系统 ─────────────────────────────────────
CREDIT_REGISTER_BONUS=100
CREDIT_SESSION_TTL_DAYS=30
CREDIT_EMAIL_TOKEN_TTL_SECONDS=900

# ── 可选：天行数据（热搜 + 网页正文抓取 htmltext）────────
# 热搜榜单与企业知识库「权威链接」正文抓取共用此 Key
TIANAPI_KEY=你的天聚数行Key

# ── 可选：GEO 多平台检索 ───────────────────────────────
# 知乎/小红书关键词搜索（Just One API）
# JUSTONEAPI_TOKEN=你的JustOneApiToken
# 贴吧关键词站点搜索降级（SerpAPI）
# SERPAPI_KEY=你的SerpApiKey

# ── 可选：火山方舟 / 豆包 2.1（文案 + GEO）────────────
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 预置推理模型 ID（豆包 2.1 Pro）
# ARK_CHAT_MODEL=doubao-seed-2-1-pro-260628
# 旧版在线推理接入点（可选，未设 ARK_CHAT_MODEL 时回退）
# ARK_ENDPOINT_ID=
# ARK_IMAGE_ENDPOINT_ID=

# ── NewAPI / aicost.xyz（Claude / ChatGPT，与 DeepSeek/豆包分离）──
# 统一中转（OpenAI 兼容 /v1/chat/completions）；Sonetto 已弃用
NEWAPI_BASE_URL=https://www.aicost.xyz
NEWAPI_KEY=sk-你的NewAPI密钥
# 默认模型（GPT 按 Token；Claude 按次）
# NEWAPI_GPT_MODEL=gpt-5.5
# NEWAPI_CLAUDE_MODEL=claude-opus-4-8
# 兼容旧变量（未设 NEWAPI_* 时回退）
# SONETTO_BASE_URL=https://www.aicost.xyz
# SONETTO_GPT_API_KEY=
# SONETTO_CLAUDE_API_KEY=
# SONETTO_GPT_MODEL=gpt-5.5
# SONETTO_CLAUDE_MODEL=claude-opus-4-8
# 计量扣费密钥（仅 Next 服务端 → FastAPI，勿暴露给浏览器）
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# CREDIT_METERED_KEY=

# ── 可选：GEO 企业知识库 Skill 生成（多模型）──────────
# KIMI_API_KEY=你的Moonshot密钥
# KIMI_MODEL=moonshot-v1-32k
# OPENAI_API_KEY=你的OpenAI密钥
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=你的Anthropic密钥
# ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-20241022
# GEMINI_API_KEY=你的Google AI密钥
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# ── 开发/生产模式 ─────────────────────────────────────
DEV_EMAIL_MODE=1
# 本地测试设为 1（邮件链接打到日志）；给别人用/上线必须设为 0

# ── 视频剪辑 BGM 目录（Docker 内固定路径，勿改）───────
VIDEO_BGM_DIR=/app/assets/bgm

# ── ffmpeg 并发（同时运行的 encode/probe 子进程上限）──
FFMPEG_MAX_CONCURRENT=2
# 可选：覆盖 ffmpeg 路径（dev:api 自动注入 tools/ffmpeg/bin；见 pnpm ffmpeg:ensure）
# FFMPEG_EXE=F:/path/to/ffmpeg.exe
# FFPROBE_EXE=F:/path/to/ffprobe.exe

# ── RunningHub 数字人视频实例类型（default | plus，默认 default）──
# RH_VIDEO_INSTANCE_TYPE=default

# ── 数字人视频创作（新）+ 宣传视频成片 — Seedance 2.0 Fast ──
# 上游文档见 接口文档/seedance2.0-fast接口文档.md 与 xinghe2.0系列接口文档.md
# 首选渠道（NewAPI 兼容 POST/GET /v1/videos）；失败时自动回退 SEEDANCE_* / aicost
SEEDANCE_PRIMARY_BASE_URL=https://api.7tai.cc
SEEDANCE_PRIMARY_API_KEY=sk-你的首选Seedance密钥
SEEDANCE_PRIMARY_MODEL=sd2-福利
# 首选渠道素材投递：url=参考图/音色先 POST /v1/assets/uploads，再传 *_urls；base64=直传（仅 aicost 备选）
SEEDANCE_PRIMARY_MEDIA_MODE=url
# 备选渠道（aicost.xyz 默认 seedance2.0-fast）
SEEDANCE_API_KEY=sk-你的Seedance密钥
SEEDANCE_BASE_URL=https://www.aicost.xyz
# XINGHE_API_KEY=sk-你的星河密钥
# XINGHE_BASE_URL=https://www.aicost.xyz
# DH_VIDEO_V2_DEFAULT_PROVIDER=seedance
# 多段 Seedance 并发上限（默认 4）
# DH_V2_MAX_PARALLEL_SEGMENTS=4
# DH_V2_SEGMENT_POLL_TIMEOUT=900
# 分镜 AI：GPT 优先，未配置则用 Claude（须配置 NEWAPI_KEY）
# NEWAPI_KEY=sk-...
# 开发 UI 走通 mock（不调用后端）：NEXT_PUBLIC_DH_VIDEO_V2_MOCK=1
# 生产/联调请设为 0 或删除
# NEXT_PUBLIC_DH_VIDEO_V2_MOCK=0

# ── 公网部署（Docker / PaaS）──────────────────────────
# web 服务（Next.js 服务端 proxy 用内网 DNS，浏览器不可见）
# FASTAPI_URL=http://api:8000
# 浏览器直连 API（视频 /static、少数未代理接口）— 生产必填公网 HTTPS
# NEXT_PUBLIC_FASTAPI_URL=https://api.你的域名.com
# FastAPI 跨域白名单（逗号分隔，勿用 * 与 credentials 混用）
# CORS_ALLOW_ORIGINS=https://www.你的域名.com,https://你的域名.com

# ── 桌面客户端中央激活 Ed25519 签名（生产必填）────────
# 生成密钥对：python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; import base64; k=Ed25519PrivateKey.generate(); print(base64.b64encode(k.private_bytes_raw()).decode())"
# CENTRAL_SIGNING_PRIVATE_KEY=base64_seed_or_PEM
# CENTRAL_SIGNING_KEY_ID=v1
# 客户端打包时设置 CENTRAL_SIGNING_PUBLIC_KEY=公钥PEM
