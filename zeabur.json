{
  "services": [
    {
      "name": "web",
      "build": {
        "dockerfile": "web/Dockerfile.web",
        "context": "."
      },
      "port": 3000,
      "env": {
        "FASTAPI_URL": "http://api.zeabur.internal:8000",
        "NEXT_PUBLIC_FASTAPI_URL": "https://zhongtaiapi.zeabur.app",
        "NODE_ENV": "production"
      }
    },
    {
      "name": "api",
      "build": {
        "dockerfile": "api/Dockerfile.api",
        "context": "."
      },
      "port": 8000,
      "volumes": [
        { "name": "data", "path": "/data" }
      ],
      "env": {
        "VIDEO_BGM_DIR": "/app/assets/bgm",
        "DATA_DIR": "/data",
        "CREDIT_DB_OVERRIDE": "/data/accounts.db",
        "PYTHONUNBUFFERED": "1",
        "CORS_ALLOW_ORIGINS": "https://zhongtai.zeabur.app",
        "APP_PUBLIC_BASE": "https://zhongtai.zeabur.app",
        "DEV_EMAIL_MODE": "0",
        "CENTRAL_LATEST_VERSION": "0.1.0",
        "CENTRAL_FORCE_UPDATE_BELOW": "0.0.1"
      }
    }
  ]
}
