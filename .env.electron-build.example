# Electron 桌面出包前构建机环境变量
# 复制为 .env.electron-build.local（git 忽略）或在 CI/本地 shell 中 export
#
# Mac CI（GitHub Actions desktop-mac）另需 Secret DESKTOP_PACKAGED_ENV
# （完整项目根 .env 文本）。见 docs/deploy/ELECTRON-BUILD-MAC.md
#
# 云端账号积分 API（迁北京后仍复用此域名，桌面无感）
# 见 docs/deploy/ZEABUR-DEPLOY.md / ZEABUR-BEIJING-MIGRATE.md

CLOUD_API_URL=https://mcap-cloud-api.preview.aliyun-zeabur.cn
CENTRAL_SERVICE_URL=https://mcap-cloud-api.preview.aliyun-zeabur.cn

# electron-updater generic 源（与 OSS releases/ 一致；Mac 另有 latest-mac.yml）
UPDATE_FEED_URL=https://mcap-desktop-releases.oss-cn-beijing.aliyuncs.com/releases/

# 与中央服务器 CENTRAL_SIGNING_PRIVATE_KEY 配对的公钥 PEM
CENTRAL_SIGNING_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----

# 可选：覆盖 electron-builder 产物版本号（默认 package.json version）
# APP_VERSION=0.1.0

# ── 发版上传 OSS（pnpm release:upload-oss；含 Setup.exe / *-mac.dmg）──
# OSS_REGION=oss-cn-beijing
# OSS_BUCKET=mcap-desktop-releases
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_PREFIX=releases
