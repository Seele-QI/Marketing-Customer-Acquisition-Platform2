# Electron NSIS 出包前构建机环境变量
# 复制为 .env.electron-build.local（git 忽略）或在 CI/本地 shell 中 export
#
# 中央激活 / 云端账号积分 API 必须先部署并可 HTTPS 访问
# 见 docs/deploy/ZEABUR-DEPLOY.md

# 云端 FastAPI 公网地址（桌面 auth/credit 走此 URL）
CLOUD_API_URL=https://mcap-prod-test1-api.zeabur.app

# 中央激活 / 心跳 / manifest（可与 CLOUD_API_URL 相同）
CENTRAL_SERVICE_URL=https://mcap-prod-test1-api.zeabur.app

# 与中央服务器 CENTRAL_SIGNING_PRIVATE_KEY 配对的公钥 PEM（单行或真实换行均可）
CENTRAL_SIGNING_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----

# 可选：覆盖 electron-builder 产物版本号（默认 package.json version）
# APP_VERSION=0.1.0
